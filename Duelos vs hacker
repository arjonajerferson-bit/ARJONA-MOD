                                    elseif arma:FindFirstChild("Hit") then
                                        arma.Hit:FireServer(enemigo.Character.HumanoidRootPart)
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

local Mouse = LocalPlayer:GetMouse()
local function obtenerJugadorMasCercano()
    local maxDistancia = math.huge
    local objetivo = nil
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild(AimPart) and v.Character:FindFirstChild("HumanoidRootPart") then
            local pos, enPantalla = game.Workspace.CurrentCamera:WorldToViewportPoint(v.Character[AimPart].Position)
            if enPantalla then
                local magnitud = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                if magnitud < maxDistancia and magnitud < 200 then
                    maxDistancia = magnitud
                    objetivo = v
                end
            end
        end
    end
    return objetivo
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "FireServer" and SilentAimbotEnabled then
        local target = obtenerJugadorMasCercano()
        if target and target.Character and target.Character:FindFirstChild(AimPart) then
            if args and typeof(args) == "Vector3" then
                args = target.Character[AimPart].Position
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

