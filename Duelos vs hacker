-- Función auxiliar para crear separadores
local function crearSeccion(texto)
    local label = Instance.new("TextLabel")
    label.Parent = ScrollingFrame
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 25)
    label.Font = Enum.Font.SourceSansBold
    label.Text = "--- " .. string.upper(texto) .. " ---"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 16
    return label
end

-- Función auxiliar para crear botones activos
local function crearBoton(texto, callback)
    local boton = Instance.new("TextButton")
    local activado = false
    boton.Parent = ScrollingFrame
    boton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    boton.Size = UDim2.new(1, 0, 0, 35)
    boton.Font = Enum.Font.SourceSans
    boton.Text = texto .. ": [OFF]"
    boton.TextColor3 = Color3.fromRGB(200, 200, 200)
    boton.TextSize = 15
    
    boton.MouseButton1Click:Connect(function()
        activado = not activado
        if activado then
            boton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            boton.TextColor3 = Color3.fromRGB(255, 255, 255)
            boton.Text = texto .. ": [ON]"
        else
            boton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            boton.TextColor3 = Color3.fromRGB(200, 200, 200)
            boton.Text = texto .. ": [OFF]"
        end
        callback(activado)
    end)
    return boton
end

